# Copy to .env.local and fill in values. Never commit secrets.

# --- Database topology (Phase 2.2) ---
# Development (Windows + SSH tunnel to remote SQL):
#   LOCAL_DB_SERVER=127.0.0.1
#   LOCAL_DB_PORT=14330            # forwarded tunnel port, NOT the SQL listener
#   HAWAI_DB_CLASS=local
#
# Production VPS (Node + SQL Server on same host):
#   DB_SERVER=127.0.0.1
#   DB_PORT=1433                   # direct SQL listener on the VPS
#   DB_DATABASE=last132_migrated
#   HAWAI_DB_CLASS=local
#   Do NOT use the VPS public IP for same-host SQL unless benchmarking paths.

# Inbound WhatsApp inbox webhook (Phase 1)
# Bearer token sent by the local WhatsApp bot when POSTing to
# /api/internal/messaging/inbox/whatsapp
WHATSAPP_INBOX_WEBHOOK_TOKEN=

# Human Handoff V1 (default OFF). Canary phones = comma-separated; empty = global when ON.
# HUMAN_HANDOFF_V1=false
# HUMAN_HANDOFF_CANARY_PHONES=
# HUMAN_HANDOFF_LEASE_MINUTES=15

# Booking Management V1 (default OFF). Cancel/reschedule of existing bookings via WhatsApp.
# BOOKING_MANAGEMENT_V1=false
# BOOKING_MANAGEMENT_CANARY_PHONES=

# Phase 2 inbox conversation worker
MESSAGING_INBOX_IDLE_MIN_MS=25
MESSAGING_INBOX_IDLE_MAX_MS=150
MESSAGING_INBOX_BATCH_SIZE=1
MESSAGING_INBOX_RECENT_ACTIVE_MS=2000
MESSAGING_INBOX_STALE_PROCESSING_MS=120000

# Phase 3 Gemini AI receptionist
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_BURST_DEBOUNCE_MS=250
AI_CONTEXT_MAX_MESSAGES=10
AI_MODEL_TIMEOUT_MS=12000
MESSAGING_AI_IDLE_MIN_MS=5
MESSAGING_AI_IDLE_MAX_MS=100
MESSAGING_AI_BATCH_SIZE=1
MESSAGING_AI_STALE_PROCESSING_MS=120000
MESSAGING_AI_RECENT_ACTIVE_MS=2000
MESSAGING_AI_MAX_RETRIES=3
