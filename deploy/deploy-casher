#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/home/casher/app"
BRANCH="main"
WORKER_UNIT_SRC="$APP_DIR/deploy/messaging-worker.service"
WORKER_UNIT_DST="/etc/systemd/system/messaging-worker.service"
NIGHTLY_SERVICE_SRC="$APP_DIR/deploy/nightly-close.service"
NIGHTLY_SERVICE_DST="/etc/systemd/system/nightly-close.service"
NIGHTLY_TIMER_SRC="$APP_DIR/deploy/nightly-close.timer"
NIGHTLY_TIMER_DST="/etc/systemd/system/nightly-close.timer"
NIGHTLY_USER_SERVICE_SRC="$APP_DIR/deploy/nightly-close.user.service"
NIGHTLY_USER_TIMER_SRC="$APP_DIR/deploy/nightly-close.user.timer"
NIGHTLY_USER_DIR="/home/casher/.config/systemd/user"

echo "======================================"
echo "  CASher Production Deploy"
echo "======================================"

cd "$APP_DIR"

echo
echo "[1/8] Checking repository..."

if ! runuser -u casher -- git diff --quiet ||
   ! runuser -u casher -- git diff --cached --quiet; then
    echo "ERROR: VPS repository has uncommitted changes."
    echo "Deploy aborted."
    exit 1
fi

echo
echo "[2/8] Fetching GitHub..."
runuser -u casher -- git fetch origin "$BRANCH"

echo
echo "[3/8] Updating code..."
runuser -u casher -- git checkout "$BRANCH"
runuser -u casher -- git pull --ff-only origin "$BRANCH"

echo
echo "[4/8] Installing dependencies..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
npm ci
"

echo
echo "[5/8] Building production..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
npm run build
"

echo
echo "[6/8] Ensuring CRON_SECRET in .env.local..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
node scripts/ensure-phase1b-secrets.cjs
"

echo
echo "[7/8] Installing/updating systemd units..."
if [[ -f "$WORKER_UNIT_SRC" ]]; then
  install -m 644 "$WORKER_UNIT_SRC" "$WORKER_UNIT_DST"
fi
if [[ -f "$NIGHTLY_SERVICE_SRC" && -f "$NIGHTLY_TIMER_SRC" ]]; then
  install -m 644 "$NIGHTLY_SERVICE_SRC" "$NIGHTLY_SERVICE_DST"
  install -m 644 "$NIGHTLY_TIMER_SRC" "$NIGHTLY_TIMER_DST"
fi
systemctl daemon-reload
if [[ -f "$WORKER_UNIT_DST" ]]; then
  systemctl enable messaging-worker.service
fi
if [[ -f "$NIGHTLY_TIMER_DST" ]]; then
  systemctl enable nightly-close.timer
  systemctl start nightly-close.timer
fi
if [[ -f "$NIGHTLY_USER_SERVICE_SRC" && -f "$NIGHTLY_USER_TIMER_SRC" ]]; then
  mkdir -p "$NIGHTLY_USER_DIR"
  install -m 644 -o casher -g casher "$NIGHTLY_USER_SERVICE_SRC" "$NIGHTLY_USER_DIR/nightly-close.service"
  install -m 644 -o casher -g casher "$NIGHTLY_USER_TIMER_SRC" "$NIGHTLY_USER_DIR/nightly-close.timer"
  runuser -u casher -- systemctl --user daemon-reload
  runuser -u casher -- systemctl --user enable nightly-close.timer
  runuser -u casher -- systemctl --user start nightly-close.timer
fi

echo
echo "[8/8] Restarting Casher + messaging worker..."
systemctl restart casher
if [[ -f "$WORKER_UNIT_DST" ]]; then
  systemctl restart messaging-worker.service
else
  CASHER_UID="$(id -u casher)"
  runuser -u casher -- env XDG_RUNTIME_DIR="/run/user/${CASHER_UID}" \
    systemctl --user restart messaging-worker.service || true
fi

sleep 3

if ! systemctl is-active --quiet casher; then
    echo
    echo "ERROR: casher.service failed."
    journalctl -u casher -n 50 --no-pager
    exit 1
fi

if ! curl -fsS --max-time 10 \
    http://127.0.0.1:3000/login >/dev/null; then
    echo
    echo "ERROR: Local health check failed."
    journalctl -u casher -n 50 --no-pager
    exit 1
fi

echo
echo "======================================"
echo " DEPLOY SUCCESSFUL"
echo "======================================"

runuser -u casher -- git log -1 --oneline

echo
echo "Service: ACTIVE"
echo "Local health: OK"
echo "Production:"
echo "https://ops.cutsaloon.com"
