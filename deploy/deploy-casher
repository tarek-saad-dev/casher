#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/home/casher/app"
BRANCH="main"
GITHUB_REPO_SLUG="tarek-saad-dev/casher"
WORKER_UNIT_SRC="$APP_DIR/deploy/messaging-worker.service"
WORKER_UNIT_DST="/etc/systemd/system/messaging-worker.service"
INBOX_WORKER_UNIT_SRC="$APP_DIR/deploy/messaging-inbox-worker.service"
INBOX_WORKER_UNIT_DST="/etc/systemd/system/messaging-inbox-worker.service"
AI_WORKER_UNIT_SRC="$APP_DIR/deploy/messaging-ai-worker.service"
AI_WORKER_UNIT_DST="/etc/systemd/system/messaging-ai-worker.service"
NIGHTLY_SERVICE_SRC="$APP_DIR/deploy/nightly-close.service"
NIGHTLY_SERVICE_DST="/etc/systemd/system/nightly-close.service"
NIGHTLY_TIMER_SRC="$APP_DIR/deploy/nightly-close.timer"
NIGHTLY_TIMER_DST="/etc/systemd/system/nightly-close.timer"

load_github_deploy_token() {
  if [[ -n "${GITHUB_DEPLOY_TOKEN:-}" ]]; then
    return 0
  fi
  if [[ -f "$APP_DIR/.deploy/github-token" ]]; then
    GITHUB_DEPLOY_TOKEN="$(tr -d '\n\r' < "$APP_DIR/.deploy/github-token")"
  elif [[ -f "/home/casher/.config/casher/github-deploy-token" ]]; then
    GITHUB_DEPLOY_TOKEN="$(tr -d '\n\r' < "/home/casher/.config/casher/github-deploy-token")"
  fi
}

ensure_casher_git_origin() {
  load_github_deploy_token
  local origin_url
  origin_url="$(runuser -u casher -- git -C "$APP_DIR" config --get remote.origin.url 2>/dev/null || true)"

  if [[ -n "${GITHUB_DEPLOY_TOKEN:-}" ]]; then
    runuser -u casher -- git -C "$APP_DIR" remote set-url origin \
      "https://x-access-token:${GITHUB_DEPLOY_TOKEN}@github.com/${GITHUB_REPO_SLUG}.git"
    return 0
  fi

  case "$origin_url" in
    git@github.com:*|ssh://git@github.com/*)
      return 0
      ;;
    https://github.com/*)
      local slug="${origin_url#https://github.com/}"
      slug="${slug%.git}"
      local ssh_dir="/home/casher/.ssh"
      mkdir -p "$ssh_dir"
      chown casher:casher "$ssh_dir"
      chmod 700 "$ssh_dir"
      if [[ -f "$ssh_dir/id_ed25519" || -f "$ssh_dir/id_rsa" ]]; then
        if ! grep -q '^github.com ' "$ssh_dir/known_hosts" 2>/dev/null; then
          ssh-keyscan -H github.com >> "$ssh_dir/known_hosts" 2>/dev/null || true
          chown casher:casher "$ssh_dir/known_hosts" 2>/dev/null || true
          chmod 644 "$ssh_dir/known_hosts" 2>/dev/null || true
        fi
        runuser -u casher -- git -C "$APP_DIR" remote set-url origin "git@github.com:${slug}.git"
        return 0
      fi
      echo "ERROR: GitHub HTTPS origin but no deploy token or SSH key for casher."
      exit 1
      ;;
    *)
      echo "ERROR: Missing or unsupported git origin: ${origin_url:-<empty>}"
      exit 1
      ;;
  esac
}

should_skip_git_sync() {
  [[ -f "$APP_DIR/.deploy/ci-sync-sha" ]]
}

gemini_api_key_configured() {
  runuser -u casher -- bash -lc "
    cd '$APP_DIR'
    node -e \"
      require('dotenv').config({ path: '.env' });
      require('dotenv').config({ path: '.env.local', override: true });
      const key = String(process.env.GEMINI_API_KEY || '').trim();
      process.exit(key ? 0 : 1);
    \"
  "
}

echo "======================================"
echo "  CASher Production Deploy"
echo "======================================"

cd "$APP_DIR"

REPO_DEPLOY_SCRIPT="$APP_DIR/deploy/deploy-casher"
if [[ -f "$REPO_DEPLOY_SCRIPT" ]]; then
  SELF_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || printf '%s' "$0")"
  REPO_PATH="$(readlink -f "$REPO_DEPLOY_SCRIPT" 2>/dev/null || realpath "$REPO_DEPLOY_SCRIPT" 2>/dev/null || printf '%s' "$REPO_DEPLOY_SCRIPT")"
  if [[ "$SELF_PATH" != "$REPO_PATH" ]]; then
    exec bash "$REPO_DEPLOY_SCRIPT" "$@"
  fi
fi

if [[ -f "$REPO_DEPLOY_SCRIPT" ]]; then
  install -m 755 "$REPO_DEPLOY_SCRIPT" "/usr/local/sbin/deploy-casher"
fi

echo
if should_skip_git_sync; then
  CI_SHA="$(tr -d '\n\r' < "$APP_DIR/.deploy/ci-sync-sha")"
  echo "[1/8] CI pre-synced checkout detected (${CI_SHA}); skipping git fetch."
else
  echo "[1/8] Syncing repository with origin/$BRANCH..."
  ensure_casher_git_origin
  runuser -u casher -- git -C "$APP_DIR" -c credential.helper= fetch origin "$BRANCH"
  runuser -u casher -- git -C "$APP_DIR" checkout "$BRANCH"

  echo
  echo "[1a/8] Removing untracked files that would block sync..."
  runuser -u casher -- bash -lc "
  cd '$APP_DIR'
  while IFS= read -r path; do
    [ -n \"\$path\" ] || continue
    if [ -e \"\$path\" ] && ! git ls-files --error-unmatch \"\$path\" >/dev/null 2>&1; then
    if git cat-file -e \"origin/$BRANCH:\$path\" 2>/dev/null; then
      echo \"Removing untracked merge blocker: \$path\"
      rm -f \"\$path\"
    fi
    fi
  done < <(git diff --name-only HEAD \"origin/$BRANCH\")
  "

  if ! runuser -u casher -- git diff --quiet ||
     ! runuser -u casher -- git diff --cached --quiet ||
     [[ "$(runuser -u casher -- git rev-parse HEAD)" != "$(runuser -u casher -- git rev-parse "origin/$BRANCH")" ]]; then
    echo "Syncing VPS checkout to origin/$BRANCH (discarding local drift if any):"
    runuser -u casher -- git status --short || true
    runuser -u casher -- git reset --hard "origin/$BRANCH"
    runuser -u casher -- git clean -fd \
      -e .env \
      -e .env.local \
      -e .env.production \
      -e .env.production.local \
      -e 'public/uploads/**' \
      -e 'uploads/**' || true
  fi
fi

echo
echo "[4/8] Installing dependencies..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
npm ci
"

echo
echo "[5/8] Building production..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
npm run build
"

echo
echo "[6/8] Ensuring CRON_SECRET in .env.local..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
node scripts/ensure-phase1b-secrets.cjs
"

echo
echo "[7a/8] Phase 3 AI schema migration..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
npm run messaging:migrate-ai
"

echo
echo "[7b/8] Salon Concierge schema migration (idempotent)..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
npm run messaging:migrate-salon-concierge
npm run messaging:migrate-salon-concierge
"

echo
echo "[7b2/8] Human Handoff schema migration (idempotent, flag stays off)..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
npm run messaging:migrate-handoff
"

echo
echo "[7b3/8] Booking Management schema migration (idempotent, flag stays off)..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
npm run messaging:migrate-booking-management
npm run messaging:migrate-booking-management
"

echo
echo "[7c/8] Salon Concierge trusted knowledge bootstrap (flag stays off)..."
runuser -u casher -- bash -lc "
cd '$APP_DIR'
npm run messaging:bootstrap-salon-concierge
"

if [[ -f "$WORKER_UNIT_SRC" ]]; then
  install -m 644 "$WORKER_UNIT_SRC" "$WORKER_UNIT_DST"
fi
if [[ -f "$INBOX_WORKER_UNIT_SRC" ]]; then
  install -m 644 "$INBOX_WORKER_UNIT_SRC" "$INBOX_WORKER_UNIT_DST"
fi
if [[ -f "$AI_WORKER_UNIT_SRC" ]]; then
  install -m 644 "$AI_WORKER_UNIT_SRC" "$AI_WORKER_UNIT_DST"
fi
if [[ -f "$NIGHTLY_SERVICE_SRC" && -f "$NIGHTLY_TIMER_SRC" ]]; then
  install -m 644 "$NIGHTLY_SERVICE_SRC" "$NIGHTLY_SERVICE_DST"
  install -m 644 "$NIGHTLY_TIMER_SRC" "$NIGHTLY_TIMER_DST"
fi
systemctl daemon-reload || true
if [[ -f "$WORKER_UNIT_DST" ]]; then
  systemctl enable messaging-worker.service || true
fi
if [[ -f "$INBOX_WORKER_UNIT_DST" ]]; then
  systemctl enable messaging-inbox-worker.service || true
fi
if [[ -f "$NIGHTLY_TIMER_DST" ]]; then
  systemctl enable nightly-close.timer || true
  systemctl start nightly-close.timer || true
fi

echo
echo "[8/8] Restarting Casher + messaging workers..."
systemctl restart casher
if [[ -f "$WORKER_UNIT_DST" ]]; then
  systemctl restart messaging-worker.service || true
fi
if [[ -f "$INBOX_WORKER_UNIT_DST" ]]; then
  systemctl restart messaging-inbox-worker.service || true
fi
if [[ -f "$AI_WORKER_UNIT_DST" ]]; then
  if gemini_api_key_configured; then
    systemctl enable messaging-ai-worker.service
    systemctl restart messaging-ai-worker.service
  else
    echo "Skipping messaging-ai-worker start/restart: GEMINI_API_KEY is not configured"
    systemctl stop messaging-ai-worker.service 2>/dev/null || true
    systemctl disable messaging-ai-worker.service 2>/dev/null || true
  fi
fi

sleep 3

if ! systemctl is-active --quiet casher; then
    echo
    echo "ERROR: casher.service failed."
    journalctl -u casher -n 50 --no-pager
    exit 1
fi

if ! curl -fsS --max-time 10 \
    http://127.0.0.1:3000/login >/dev/null; then
    echo
    echo "ERROR: Local health check failed."
    journalctl -u casher -n 50 --no-pager
    exit 1
fi

echo
echo "======================================"
echo " DEPLOY SUCCESSFUL"
echo "======================================"

runuser -u casher -- git log -1 --oneline

echo
echo "Service: ACTIVE"
echo "Local health: OK"
echo "Production:"
echo "https://ops.cutsaloon.com"

if [[ -f "$APP_DIR/deploy/deploy-casher" ]]; then
  install -m 755 "$APP_DIR/deploy/deploy-casher" "/usr/local/sbin/deploy-casher"
fi
