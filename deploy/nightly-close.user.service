[Unit]
Description=Casher Nightly Close (attendance lock + payroll + targets)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/casher/app
Environment=NODE_ENV=production
Environment=HOME=/home/casher
Environment=NIGHTLY_CLOSE_BASE_URL=http://127.0.0.1:3000
ExecStart=/usr/bin/npm run nightly-close
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900

[Install]
WantedBy=default.target
